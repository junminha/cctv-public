# Copy to .env in this folder (Git ignores .env). Process environment variables override .env.
# Never commit real keys. The browser/Expo app never receives these values.

# OpenAI (optional). Empty key => local classification and manual review only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe

# AI worker on notebook B. auto => CUDA when available, otherwise CPU.
CCTV_WORKER_ENABLED=true
CCTV_AUTO_ANALYZE=true
CCTV_AI_DEVICE=auto
# Defaults: runtime/models/yolo26n.pt and runtime/models/pose_landmarker_lite.task (setup_models.py).
CCTV_YOLO_MODEL=
CCTV_POSE_MODEL=

# Allowed browser origins for the admin WebSocket (comma separated).
CCTV_ADMIN_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional overrides; defaults live under runtime/ (Git ignored).
# CCTV_ADAPTER_URL=https://<A-host>.<tailnet>.ts.net
# CCTV_ADAPTER_TOKEN=<A token, supplied privately>
# CCTV_A_SECRETS_FILE=C:/private-data/a-secrets.json
# CCTV_B_SECRETS_FILE=C:/private-data/b-secrets.json
# CCTV_B_DATABASE=C:/private-data/central.sqlite3
# CCTV_B_CLIPS_DIR=C:/private-data/preserved-clips
# CCTV_B_ATTACHMENTS_DIR=C:/private-data/attachments
# CCTV_B_ANALYSIS_DIR=C:/private-data/analysis
# CCTV_FFMPEG=C:/video-tools/ffmpeg.exe
# CCTV_FFPROBE=C:/video-tools/ffprobe.exe
